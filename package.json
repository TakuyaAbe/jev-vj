{
  "name": "jev-vj",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5183 --strictPort",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "deploy": "npm run build && XDG_CONFIG_HOME=\"$PWD/.cf\" wrangler deploy",
    "preview:worker": "npm run build && wrangler dev --port 8788",
    "login": "XDG_CONFIG_HOME=\"$PWD/.cf\" wrangler login",
    "whoami": "XDG_CONFIG_HOME=\"$PWD/.cf\" wrangler whoami",
    "secret": "XDG_CONFIG_HOME=\"$PWD/.cf\" wrangler secret put TYPESAFE_API_KEY",
    "tracks": "node scripts/fetch-tracks.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.136.3"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.0"
  }
}
