{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-vj",
  // personal account (a.taku275@gmail.com) — the one that owns the sayuno.me zone; login lives in ./.cf (npm run login)
  "account_id": "d011b354fed440f212db8324bb8ec38d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // run_worker_first: every request goes through the Worker (API routing, headers) before the static assets
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  // secret (wrangler secret put): TYPESAFE_API_KEY
  "vars": { "TYPESAFE_MODEL": "jev-latest" },
  // /api/jev spend guard: per client IP and site-wide (Workers Rate Limiting binding)
  "ratelimits": [
    { "name": "JEV_RL", "namespace_id": "1001", "simple": { "limit": 90, "period": 60 } },
    { "name": "JEV_RL_GLOBAL", "namespace_id": "1002", "simple": { "limit": 400, "period": 60 } }
  ],
  "routes": [{ "pattern": "jevj.sayuno.me", "custom_domain": true }],
  "observability": { "enabled": true }
}
